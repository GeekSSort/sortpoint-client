# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Alternate build dirs (NEXT_DIST_DIR). Must be ignored: Tailwind v4 reads
# .gitignore to decide what to scan for classes, and an unignored build dir
# makes it extract garbage class names out of compiled binaries.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright / chromatic
/test-results/
/playwright-report/
/blob-report/
/.playwright-mcp/
/playwright/.cache/
chromatic.log
build-storybook.log
