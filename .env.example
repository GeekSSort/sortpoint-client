# Copy to .env.local. Both values are optional; the defaults suit local dev.

# Leave UNSET when tenants have their own subdomains. One bundle serves every
# tenant, so a baked-in API URL would send rahman.localhost's requests to the
# wrong host and the backend would answer 403 TENANT_MISMATCH. Unset, the API
# host is derived from the page's own location.
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Port the Django API listens on. Scheme and host come from the browser.
NEXT_PUBLIC_API_PORT=8000

# Which addresses are the CONSOLE and which are a customer's shop. Must match
# PLATFORM_BASE_DOMAIN / PLATFORM_HOSTS on the server.
NEXT_PUBLIC_PLATFORM_BASE_DOMAIN=localhost
NEXT_PUBLIC_PLATFORM_HOSTS=localhost,127.0.0.1,admin.localhost
